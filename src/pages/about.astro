---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skills from '../components/Skills.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { ArrowRight } from '@lucide/astro';
import { education } from '../data/experience';
---
<BaseLayout title="About" description="Meet Aashish Nayak, a Jaipur-based software engineer building Laravel backends, full-stack applications, and AI-integrated products.">
  <div class="page-intro"><h1>A little about me<span class="red">.</span></h1><p>I’m Aashish, a software engineer in Jaipur. I like working on the parts that make a product useful, from its first API call to its everyday workflows.</p></div>
  <section class="section grid md:grid-cols-[1.5fr_1fr] gap-12"><div class="prose"><h2>From backends to complete products</h2><p>I started with PHP and Laravel, building and maintaining web applications. That work grew into third-party integrations, payment systems, reporting tools, and real-time experiences.</p><p>Working across Laravel, Vue.js, and React has helped me think beyond an individual feature: how data moves, how systems connect, and how the whole application serves the person using it.</p><h2>What I bring to the work</h2><p>My experience includes insurance-provider integrations, secure payment workflows, SQL optimization, and automation. I enjoy making complex workflows easier to operate and maintain.</p><h2>What I’m learning next</h2><p>I’m expanding into AI engineering through LLM APIs, document workflows, RAG systems, LangChain, vector databases, Python, and AI agents. These are active learning areas, not claims of professional mastery.</p><a class="text-link red" href="/resume">View Resume <ArrowRight size={19}/></a></div><div><figure class="portrait-wrap"><div class="polaroid"><picture><source srcset="/images/aashish-profile.webp" type="image/webp" /><img src="/images/aashish-profile.jpg" alt="Aashish Nayak" width="460" height="460" loading="lazy" decoding="async"/></picture></div><figcaption class="portrait-note">Based in Jaipur, India.</figcaption></figure><div class="mt-14"><h2 class="sticky-title">The Foundation</h2><div class="flex flex-col gap-6">{education.map(e => <div><p class="meta">{e.dates}</p><h3 class="text-2xl mt-1">{e.degree}</h3><p class="mt-1 muted">{e.institution}</p>{e.details && e.details.length > 0 && <p class="mt-2 text-lg">{e.details.join(' • ')}</p>}</div>)}</div></div></div></section>
  <section class="section"><h2 class="sticky-title">My Toolkit</h2><Skills detailed /></section>
  <section class="section"><h2 class="sticky-title">Along the Way</h2><div class="grid md:grid-cols-3 gap-8"><div><p class="meta">2021</p><h3 class="mt-2">Application development</h3><p class="mt-2">Joined Scrum Digital, working on Laravel and Vue.js applications.</p></div><div><p class="meta">2023</p><h3 class="mt-2">Broader integrations</h3><p class="mt-2">Joined AddWeb Solution. Received the Emerging Star of the Team Award.</p></div><div><p class="meta">2024 - Present</p><h3 class="mt-2">Backend workflows</h3><p class="mt-2">At Fondos Tech, building insurance, payment, and reporting integrations.</p></div></div></section>
  <ContactCTA/>
</BaseLayout>
