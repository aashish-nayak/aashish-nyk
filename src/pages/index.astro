---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';
import { ArrowRight, ArrowUpLeft, ArrowUpRight, Download } from '@lucide/astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { experience, education } from '../data/experience';
---
<BaseLayout title="Home">
  <section class="hero" aria-label="Introduction">
    <div class="hero-copy">
      <h1 class="hero-title">Hi, I’m <span class="hero-name">Aashish.</span></h1>
      <p class="hero-intro">a <span class="highlight">software engineer</span> building <span class="highlight-pink">backends & full-stack products</span>, with a growing focus on AI.</p>
      <ul class="tag-list" aria-label="Core skills">{['PHP / Laravel','full-stack','Vue.js','React','TypeScript','AI integrations'].map(t => <li class="tag">{t}</li>)}</ul>
      <div class="actions"><a href="/projects" class="sketch-button sketch-button-explore">Explore Projects <ArrowRight size={21}/></a><a href="/contact" class="text-link">Get in Touch <ArrowUpRight size={19}/></a></div>
      <div class="status" aria-label="Current status"><span class="meta">Status</span><span class="meta-dot">&bull;</span><span class="status-highlight">open to work &bull; {site.status}</span><span class="status-dot" aria-hidden="true"></span></div>
      <div class="flex flex-wrap gap-6 mt-3 text-lg"><a href={site.github} class="text-link">View GitHub <ArrowUpRight size={16}/></a><a href={site.resume || '/resume'} class="text-link" download={site.resume ? true : undefined}>{site.resume ? 'Download Resume' : 'View Resume'} <Download size={16}/></a></div>
    </div>
    <figure class="portrait-wrap"><div class="polaroid"><picture><source srcset="/images/aashish-profile.webp" type="image/webp" /><img src="/images/aashish-profile.jpg" width="460" height="460" alt="Aashish Nayak" fetchpriority="high" decoding="async" /></picture></div><figcaption class="portrait-note"><ArrowUpLeft size={37}/> that’s me, say hi</figcaption></figure>
  </section>
  <section class="section" aria-labelledby="bio-heading"><h2 id="bio-heading" class="sticky-title">Personal Bio</h2><p class="bio">I build products, not just features. For 5+ years, I’ve worked on web applications, reliable backends, and the integrations that connect them. From payments and reporting to real-time cricket scoring, I enjoy turning real problems into working software. Now, I’m exploring what AI can add to that toolkit.</p><div class="scribble-rule" aria-hidden="true"></div></section>
  <section class="section" aria-labelledby="experience-heading"><h2 id="experience-heading" class="sticky-title">Experience</h2><div class="role-grid">{experience.map(e => <article class="role"><p class="meta">{e.dates}</p><div><h3>{e.role}</h3><p class="company">@ {e.company}</p><p>{e.summary}</p></div></article>)}</div><div class="section-end"><a class="text-link red" href="/experience">Full experience <ArrowRight size={20}/></a></div></section>
  <section class="section education-skills"><div><h2 class="sticky-title">Education</h2><div class="flex flex-col gap-6">{education.map(e => <div><p class="meta">{e.dates}</p><h3 class="text-2xl mt-1">{e.degree}</h3><p class="muted mt-1">{e.institution}</p>{e.details && e.details.length > 0 && <p class="mt-2 text-lg">{e.details.join(' • ')}</p>}</div>)}</div><a class="text-link mt-6" href="/about">More about me <ArrowRight size={19}/></a></div><div><h2 class="sticky-title">Good At</h2><Skills /></div></section>
  <section class="section" aria-labelledby="work-heading"><h2 id="work-heading" class="sticky-title">Featured Work</h2><div class="project-grid">{projects.filter(p => p.featured).map(p => <ProjectCard project={p}/>)}</div><div class="section-end"><a class="text-link red" href="/projects">Explore Projects <ArrowRight size={20}/></a></div></section>
  <section class="section"><h2 class="sticky-title">Behind the Build</h2><div class="grid md:grid-cols-2 gap-x-16 gap-y-6"><div><h3>Integrations that do the work</h3><p class="mt-3">Insurance-provider APIs, secure BillDesk payments with JWS signing, and automated Excel reporting.</p></div><div><h3>Systems that stay connected</h3><p class="mt-3">SQL optimization, WebSockets for real-time communication, and LLM APIs for content and document workflows.</p></div></div></section>
  <ContactCTA />
</BaseLayout>
