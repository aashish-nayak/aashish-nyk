---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';
export function getStaticPaths() { return projects.map((project,index) => ({ params:{slug:project.slug}, props:{project,index} })); }
const { project:p, index } = Astro.props;
const related = projects.filter(other => other.slug !== p.slug && other.tags.some(t => p.tags.includes(t))).slice(0,2);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
---
<BaseLayout title={p.title} description={p.summary}>
  <div class="page-intro"><a class="text-link" href="/projects/"><ArrowLeft size={18}/> All projects</a><h1>{p.title}<span class="red">.</span></h1><p>{p.summary}</p><div class="actions">{p.liveUrl && <a class="sketch-button" href={p.liveUrl} target="_blank" rel="noopener noreferrer">Visit live site <ArrowUpRight size={20}/></a>}{p.repositoryUrl && <a class="text-link" href={p.repositoryUrl} target="_blank" rel="noopener noreferrer">View source <ArrowUpRight size={20}/></a>}</div></div>
  <div class="detail-grid"><article class="prose">
    {p.problem && <><h2>The problem</h2><p>{p.problem}</p></>}
    {p.implementation && <><h2>How it comes together</h2><p>{p.implementation}</p></>}
    {p.features && <><h2>Documented work</h2><ul>{p.features.map(f => <li>{f}</li>)}</ul></>}
    {p.image && <figure class="project-shot"><img src={p.image} width="1920" height="912" alt="Wickto cricket scorecard interface" loading="lazy"/><figcaption>Scorecard from the Wickto project’s local product assets.</figcaption></figure>}
    {p.challenges && <><h2>Challenges & trade-offs</h2><ul>{p.challenges.map(f => <li>{f}</li>)}</ul></>}
    {p.learnings && <><h2>What I learned</h2><ul>{p.learnings.map(f => <li>{f}</li>)}</ul></>}
    <h2>Want to talk through it?</h2><p>Get in touch to discuss the project and my work in more detail.</p><a class="text-link red" href="/contact/">Get in Touch <ArrowRight size={19}/></a>
  </article><aside class="project-aside"><h2 class="marker">Project notebook</h2><p class="meta">Type</p><p>{p.category}</p>{p.role && <><p class="meta">My role</p><p>{p.role}</p></>}<p class="meta">Status</p><p>{p.status || 'Release status not documented'}</p>{p.technologies.length > 0 && <><p class="meta">Built with</p><ul class="tag-list">{p.technologies.map(t => <li class="tag">{t}</li>)}</ul></>}<p class="text-base muted mt-6">Notes reflect documented project work. Undocumented architecture, metrics, and launch claims are omitted.</p></aside></div>
  {related.length > 0 && <section class="section"><h2 class="sticky-title">Related Work</h2><div class="grid md:grid-cols-2 gap-6">{related.map(project => <ProjectCard project={project}/>)}</div></section>}
  <nav class="project-navigation" aria-label="Previous and next projects"><a class="text-link" href={`/projects/${previous.slug}/`}><ArrowLeft size={18}/>{previous.title}</a><a class="text-link" href={`/projects/${next.slug}/`}>{next.title}<ArrowRight size={18}/></a></nav>
</BaseLayout>
