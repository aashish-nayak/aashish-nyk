---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowRight, NotebookPen } from '@lucide/astro';
const entries = (await getCollection('writing', ({data}) => !data.draft)).sort((a,b) => b.data.published.getTime() - a.data.published.getTime());
---
<BaseLayout title="Writing" description="Engineering notes by Aashish Nayak on Laravel, API integrations, SQL, real-time systems, and AI-powered applications.">
  <div class="page-intro"><h1>Notes from the work<span class="red">.</span></h1><p>A place for lessons from backend engineering, product development, and learning AI.</p></div>
  <section class="section">{entries.length ? <div class="grid gap-8">{entries.map(entry => <article><p class="meta"><time datetime={entry.data.published.toISOString()}>{entry.data.published.toLocaleDateString('en-IN',{year:'numeric',month:'long',day:'numeric'})}</time></p><h2 class="text-3xl mt-2"><a href={`/writing/${entry.id}`}>{entry.data.title}</a></h2><p class="mt-2">{entry.data.description}</p></article>)}</div> : <div class="empty-note"><NotebookPen size={42} class="red mb-5"/><h2 class="marker">A fresh page.</h2><p>No articles published yet. In the meantime, my project notes cover the applications and integrations I’ve worked on.</p><a class="text-link red mt-6" href="/projects">Explore Projects <ArrowRight size={20}/></a></div>}</section>
</BaseLayout>
