---
import '../styles/global.css';
import { Moon, Sun, Menu, X, ArrowUp } from '@lucide/astro';
import { site, navigation } from '../data/site';
import { faqs } from '../data/faq';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: string;
  ogImage?: string;
  includeFaqSchema?: boolean;
  customSchema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = site.description,
  noindex = false,
  ogType = 'website',
  ogImage,
  includeFaqSchema = false,
  customSchema,
} = Astro.props;

const siteOrigin = (Astro.site ? Astro.site.href : 'https://aashish-nyk.vercel.app').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const current = Astro.url.pathname;
const active = (href: string) => {
  const normCurrent = current.replace(/\/$/, '') || '/';
  const normHref = href.replace(/\/$/, '') || '/';
  return normHref === '/' ? normCurrent === '/' : (normCurrent === normHref || normCurrent.startsWith(`${normHref}/`));
};
const pageTitle = title === 'Home' ? 'Aashish Nayak | Software Engineer, Backend & Full-Stack' : `${title} | Aashish Nayak`;
const socialImage = ogImage || new URL('/images/og-image.png', siteOrigin).href;

// Structured Data Graph for GEO, AEO & Technical SEO
const personSchema = {
  '@type': 'Person',
  '@id': `${siteOrigin}/#person`,
  name: site.name,
  alternateName: ['Aashish', 'Ashu Nayak'],
  jobTitle: 'Software Engineer',
  description: site.description,
  url: siteOrigin,
  image: new URL('/images/aashish-profile.jpg', siteOrigin).href,
  telephone: site.phone,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Jaipur',
    addressRegion: 'Rajasthan',
    addressCountry: 'India',
  },
  sameAs: [site.github, site.linkedin],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University Maharaja College, Jaipur',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Fondos Tech Pvt. Ltd.',
  },
  knowsAbout: [
    'PHP',
    'Laravel',
    'REST APIs',
    'Backend Architecture',
    'Full-Stack Development',
    'Vue.js',
    'React',
    'TypeScript',
    'Astro',
    'Tailwind CSS',
    'SQL Query Optimization',
    'WebSockets',
    'Firebase',
    'Payment Gateways',
    'Artificial Intelligence',
    'Google Gemini API',
    'WebAssembly',
  ],
};

const serviceSchema = {
  '@type': 'ProfessionalService',
  '@id': `${siteOrigin}/#service`,
  name: 'Aashish Nayak — Software Engineering & Consulting',
  url: siteOrigin,
  provider: { '@id': `${siteOrigin}/#person` },
  image: new URL('/images/aashish-profile.jpg', siteOrigin).href,
  description: 'Professional backend systems architecture, full-stack application development, payment integrations, and AI-enabled product workflows for startups and clients.',
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Jaipur',
    addressRegion: 'Rajasthan',
    addressCountry: 'India',
  },
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Software Engineering Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Backend Architecture & REST APIs',
          description: 'Scalable Laravel backends, database schema design, and secure payment and third-party integrations.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Full-Stack Web Development',
          description: 'Production web applications built with Laravel, Vue.js, React, TypeScript, and modern frontend tools.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'AI & LLM Integration Engineering',
          description: 'Integrating Gemini and LLM APIs, prompt engineering pipelines, and streaming content generation into business workflows.',
        },
      },
    ],
  },
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: siteOrigin,
  name: 'Aashish Nayak | Software Engineer Portfolio',
  description: site.description,
  publisher: { '@id': `${siteOrigin}/#person` },
  inLanguage: 'en-US',
};

const breadcrumbSchema =
  title !== 'Home'
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: siteOrigin,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: title,
            item: canonical,
          },
        ],
      }
    : undefined;

const faqSchema = includeFaqSchema
  ? {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    }
  : undefined;

const extraSchemas = Array.isArray(customSchema) ? customSchema : customSchema ? [customSchema] : [];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema,
    serviceSchema,
    websiteSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...(faqSchema ? [faqSchema] : []),
    ...extraSchemas,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Aashish Nayak" />
    <meta name="theme-color" content="#faf9f5" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Geo Meta Tags for Local & Regional AEO/GEO Signals -->
    <meta name="geo.region" content="IN-RJ" />
    <meta name="geo.placename" content="Jaipur" />
    <meta name="geo.position" content="26.9124;75.7873" />
    <meta name="ICBM" content="26.9124, 75.7873" />

    <title>{pageTitle}</title>

    <!-- Open Graph (Facebook, LinkedIn, Discord, Slack) -->
    <meta property="og:site_name" content="Aashish Nayak" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aashish Nayak — Software Engineer" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Aashish Nayak — Software Engineer" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      try { const saved = localStorage.getItem('portfolio-theme'); document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="wordmark" href="/" aria-label="Aashish Nayak home">// Aashish Nayak</a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {navigation.map(([label,href]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label.toLowerCase()}</a>)}
        <a href="/resume" aria-current={active('/resume') ? 'page' : undefined}>resume</a>
      </nav>
      <div class="flex items-center gap-1">
        <button class="icon-button theme-toggle" aria-label="Switch color theme"><span class="moon"><Moon size={19}/></span><span class="sun" hidden><Sun size={19}/></span></button>
        <button class="icon-button mobile-toggle" aria-label="Open navigation" aria-controls="mobile-nav" aria-expanded="false"><span class="menu-icon"><Menu size={25}/></span><span class="close-icon" hidden><X size={25}/></span></button>
      </div>
    </header>
    <nav id="mobile-nav" class="wrap mobile-nav" aria-label="Mobile navigation" hidden>
      {navigation.map(([label,href]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      <a href="/resume" aria-current={active('/resume') ? 'page' : undefined}>Resume</a>
    </nav>
    <main id="main" class="wrap" tabindex="-1"><slot /></main>
    <footer class="wrap site-footer">
      <p class="meta">© {new Date().getFullYear()} Aashish Nayak</p>
      <div class="footer-links">
        <a class="text-link" href={`mailto:${site.email}`}>Email</a>
        <a class="text-link" href={site.github}>GitHub</a>
        <a class="text-link" href={site.linkedin}>LinkedIn</a>
        <a class="text-link" href="#top">Back to top <ArrowUp size={17} /></a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.mobile-toggle')!;
      const nav = document.querySelector<HTMLElement>('#mobile-nav')!;
      function closeMenu() { nav.hidden = true; toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Open navigation'); toggle.querySelector('.menu-icon')?.removeAttribute('hidden'); toggle.querySelector('.close-icon')?.setAttribute('hidden',''); }
      toggle.addEventListener('click', () => { const open = Boolean(nav.hidden); nav.hidden = !open; toggle.setAttribute('aria-expanded',String(open)); toggle.setAttribute('aria-label',open ? 'Close navigation' : 'Open navigation'); toggle.querySelector('.menu-icon')?.toggleAttribute('hidden',open); toggle.querySelector('.close-icon')?.toggleAttribute('hidden',!open); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && !nav.hidden) { closeMenu(); toggle.focus(); } });
      matchMedia('(min-width:901px)').addEventListener('change', e => { if(e.matches) closeMenu(); });
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      function syncTheme() { const dark = document.documentElement.dataset.theme === 'dark'; themeButton.setAttribute('aria-label',dark ? 'Switch to light theme' : 'Switch to dark theme'); themeButton.querySelector('.moon')?.toggleAttribute('hidden',dark); themeButton.querySelector('.sun')?.toggleAttribute('hidden',!dark); }
      syncTheme();
      themeButton.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('portfolio-theme',next); } catch {} syncTheme(); });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => { try { if(localStorage.getItem('portfolio-theme')) return; } catch {} document.documentElement.dataset.theme = e.matches ? 'dark' : 'light'; syncTheme(); });
    </script>
    <script
      is:inline
      src="https://buymeatea.in/embed.js"
      data-user="ashunyk"
      data-style="tapri"
      data-size="sm"
      data-float="right"
    ></script>
  </body>
</html>

