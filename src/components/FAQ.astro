---
import { faqs } from '../data/faq';
import { ChevronDown } from '@lucide/astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Frequently Asked Questions',
  subtitle = 'Clear answers about my background, technical services, and working together.',
} = Astro.props;
---

<section class="section faq-section" aria-labelledby="faq-heading">
  <div class="faq-header">
    <h2 id="faq-heading" class="sticky-title">{title}</h2>
    <p class="faq-subtitle">{subtitle}</p>
  </div>

  <div class="faq-list">
    {faqs.map((faq, index) => (
      <details class="faq-item" open={index === 0}>
        <summary class="faq-summary">
          <span class="faq-question">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-icon" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg>
            <span>{faq.question}</span>
          </span>
          <ChevronDown size={20} class="faq-chevron" />
        </summary>
        <div class="faq-content">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section {
    margin-top: 50px;
    margin-bottom: 70px;
  }
  .faq-subtitle {
    font-size: 24px;
    margin-top: 10px;
    margin-bottom: 28px;
    color: var(--muted);
    max-width: 750px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 860px;
  }
  .faq-item {
    border: 1.8px solid var(--ink);
    border-radius: 12px 14px 10px 13px / 13px 10px 14px 12px;
    background: var(--card);
    box-shadow: 2px 3px 0 var(--ink);
    transition: transform 0.2s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.2s ease;
    overflow: hidden;
  }
  .faq-item:hover {
    box-shadow: 3px 5px 0 var(--ink);
  }
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    font-size: 22px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .faq-question {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
  }
  .faq-icon {
    color: var(--red);
    flex-shrink: 0;
  }
  .faq-chevron {
    color: var(--muted);
    transition: transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
    flex-shrink: 0;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-content {
    padding: 0 20px 20px 52px;
    border-top: 1px dashed var(--line);
    margin-top: 4px;
    padding-top: 14px;
  }
  .faq-content p {
    font-size: 21px;
    line-height: 1.45;
    color: var(--ink);
    margin: 0;
  }
  @media (max-width: 767px) {
    .faq-summary {
      font-size: 19px;
      padding: 14px 16px;
      gap: 12px;
    }
    .faq-content {
      padding: 12px 16px 16px 16px;
    }
    .faq-content p {
      font-size: 18px;
    }
  }
</style>
